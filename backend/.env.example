NODE_ENV=production
PORT=3000
# Must be at least 16 characters. Set only on the VPS.
ADMIN_PASSWORD=replace-with-a-long-random-password
# Generate with: openssl rand -hex 32. Set only on the VPS.
SESSION_SECRET=replace-with-64-hex-characters
# Exact HTTPS origin of the GitHub Pages site.
ALLOWED_ORIGINS=https://high-cde.github.io
# Provider credentials stay on the VPS, never in GitHub Pages files.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
